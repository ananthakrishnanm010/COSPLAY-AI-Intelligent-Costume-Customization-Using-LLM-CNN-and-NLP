{
  "name": "thread-and-form",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cosplay - A Modern Clothing E-commerce Platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev -w client\" \"npm run dev -w server\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "globals": "^15.1.0",
    "prettier": "^3.2.5"
  }
}

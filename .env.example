# ==============================================================================
# Thread & Form Environment Variables Template
# Copy this file to '.env' and fill in your local secrets.
# ==============================================================================

# --- Server Configurations ---
PORT=5000
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_passphrase_change_me
JWT_EXPIRES_IN=7d

# --- Database Configurations (Neon / PostgreSQL) ---
# Neon URL format: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL="postgresql://johndoe:mypassword@localhost:5432/thread_and_form?schema=public"

# --- Frontend Configurations (Vite requires VITE_ prefix for exposure) ---
VITE_API_URL="http://localhost:5000/api/v1"

# --- Third Party Services (e.g., Stripe, Cloudinary) ---
STRIPE_SECRET_KEY=sk_test_placeholder
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
